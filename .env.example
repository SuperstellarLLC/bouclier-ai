# ──────────────────────────────────────────────
# Bouclier.ai — Environment Variables
# Copy this file to .env.local and fill in values
# ──────────────────────────────────────────────

# ── App ───────────────────────────────────────
NODE_ENV=development
NEXT_PUBLIC_APP_URL=http://localhost:3000

# ── Downloads ────────────────────────────────
# Required to serve /api/download redirects. This is the directory that
# contains Bouclier-ai-v<version>-macOS.dmg.
# DOWNLOAD_REDIRECT_BASE=https://downloads.example.com/releases

# Optional anonymous download counters and report-PoW replay protection.
# Both values are required to enable Upstash-backed storage.
# UPSTASH_REDIS_REST_URL=https://example.upstash.io
# UPSTASH_REDIS_REST_TOKEN=

# Optional operator-only token for GET /api/download/stats (minimum 16 chars).
# Without it the stats endpoint returns 404.
# DOWNLOAD_STATS_TOKEN=

# ── False-positive reports ───────────────────
# Required for POST /api/report to accept reports. The schema is created on
# first write. Without it the endpoint returns 503 and logs no report content.
# DATABASE_URL=

# Optional proof-of-work difficulty in leading zero bits (0-32, default 20).
# Raising above 20 makes currently shipped clients unable to submit reports.
# REPORT_POW_BITS=20
