{
  "name": "bouclier-ai",
  "version": "0.4.0",
  "private": true,
  "description": "Local-only macOS proxy that stops prompt injections and PII from leaking to LLMs — in text, images, PDFs, and audio.",
  "homepage": "https://www.bouclier.ai",
  "repository": {
    "type": "git",
    "url": "https://github.com/SuperstellarLLC/ilvarion.git"
  },
  "bugs": {
    "url": "https://github.com/SuperstellarLLC/ilvarion/issues"
  },
  "license": "Apache-2.0",
  "author": "Superstellar LLC",
  "packageManager": "pnpm@9.15.0",
  "engines": {
    "node": ">=22.0.0"
  },
  "scripts": {
    "dev": "turbo dev",
    "build": "turbo build",
    "lint": "turbo lint",
    "typecheck": "turbo typecheck",
    "test": "turbo test",
    "test:e2e": "turbo test:e2e",
    "format": "prettier --write .",
    "format:check": "prettier --check .",
    "check": "turbo typecheck lint test && prettier --check .",
    "prepare": "husky"
  },
  "devDependencies": {
    "@commitlint/cli": "^19.0.0",
    "@commitlint/config-conventional": "^19.0.0",
    "@commitlint/types": "^19.0.0",
    "husky": "^9.1.0",
    "lint-staged": "^15.4.0",
    "prettier": "^3.5.0",
    "prettier-plugin-tailwindcss": "^0.6.0",
    "turbo": "^2.4.0"
  },
  "pnpm": {
    "overrides": {
      "fast-uri": ">=3.1.2",
      "postcss": ">=8.5.10"
    }
  }
}
