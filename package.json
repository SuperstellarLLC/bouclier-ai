{
  "name": "bouclier-ai",
  "version": "0.4.0",
  "private": true,
  "description": "Local-only macOS proxy that keeps your API keys and secrets out of the model.",
  "homepage": "https://www.bouclier.ai",
  "repository": {
    "type": "git",
    "url": "https://github.com/SuperstellarLLC/bouclier-ai.git"
  },
  "bugs": {
    "url": "https://github.com/SuperstellarLLC/bouclier-ai/issues"
  },
  "license": "Apache-2.0",
  "author": "Superstellar LLC",
  "packageManager": "pnpm@9.15.0",
  "engines": {
    "node": ">=22.0.0"
  },
  "scripts": {
    "dev": "turbo dev",
    "build": "turbo build",
    "lint": "turbo lint",
    "typecheck": "turbo typecheck",
    "test": "turbo test",
    "test:e2e": "turbo test:e2e",
    "format": "prettier --write .",
    "format:check": "prettier --check .",
    "check": "turbo typecheck lint test && prettier --check .",
    "prepare": "husky"
  },
  "devDependencies": {
    "@commitlint/cli": "^19.0.0",
    "@commitlint/config-conventional": "^19.0.0",
    "@commitlint/types": "^19.0.0",
    "husky": "^9.1.0",
    "lint-staged": "^15.4.0",
    "prettier": "^3.9.4",
    "prettier-plugin-tailwindcss": "^0.8.0",
    "turbo": "^2.10.3"
  },
  "pnpm": {
    "overrides": {
      "fast-uri": ">=3.1.2",
      "postcss": ">=8.5.10",
      "ws": ">=8.20.1",
      "brace-expansion@>=5.0.0 <5.0.6": ">=5.0.6",
      "@babel/core": "7.29.6",
      "esbuild": "0.28.1",
      "undici": "6.27.0",
      "vite": "7.3.5",
      "vitest": "3.2.6",
      "js-yaml": "4.2.0"
    }
  }
}
