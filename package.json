{
  "name": "bouclier-ai",
  "private": true,
  "description": "Local-only macOS prompt-injection monitor and optional blocker for AI coding agents.",
  "homepage": "https://www.bouclier.ai",
  "repository": {
    "type": "git",
    "url": "https://github.com/SuperstellarLLC/bouclier-ai.git"
  },
  "bugs": {
    "url": "https://github.com/SuperstellarLLC/bouclier-ai/issues"
  },
  "license": "Apache-2.0",
  "author": "Superstellar LLC",
  "packageManager": "pnpm@9.15.0",
  "engines": {
    "node": ">=22.0.0"
  },
  "scripts": {
    "dev": "turbo dev",
    "build": "turbo build",
    "lint": "turbo lint",
    "typecheck": "turbo typecheck",
    "test": "turbo test",
    "test:e2e": "turbo test:e2e",
    "format": "prettier --write .",
    "format:check": "prettier --check .",
    "check": "turbo typecheck lint test && node scripts/check-pattern-sync.mjs && prettier --check .",
    "prepare": "husky"
  },
  "devDependencies": {
    "@commitlint/cli": "^19.0.0",
    "@commitlint/config-conventional": "^19.0.0",
    "@commitlint/types": "^19.0.0",
    "husky": "^9.1.0",
    "lint-staged": "^15.4.0",
    "prettier": "^3.9.6",
    "prettier-plugin-tailwindcss": "^0.8.1",
    "turbo": "^2.10.12"
  },
  "pnpm": {
    "overrides": {
      "fast-uri": ">=3.1.3 <4",
      "postcss": ">=8.5.18 <9",
      "ws": ">=8.20.1",
      "@babel/core": "7.29.6",
      "esbuild": "0.28.1",
      "undici": ">=6.28.0 <7",
      "vite": "7.3.5",
      "vitest": "3.2.6",
      "js-yaml": ">=4.3.0 <5",
      "nanoid": ">=3.3.16 <4",
      "sharp": ">=0.35.0 <0.36",
      "next": ">=16.2.11 <17",
      "brace-expansion@<2": ">=1.1.16 <2",
      "brace-expansion@>=2 <3": ">=2.1.2 <3",
      "brace-expansion@>=5": ">=5.0.7 <6",
      "brace-expansion@5.0.6": "5.0.9"
    }
  }
}
